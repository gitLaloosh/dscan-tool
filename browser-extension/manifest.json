{
  "manifest_version": 3,
  "name": "Threat Vector for zKillboard",
  "short_name": "Threat Vector",
  "version": "1.1.0",
  "description": "Right-click a zKillboard kill or pilot, or a selected pilot name, to open it in Threat Vector.",
  "permissions": ["contextMenus", "storage"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
